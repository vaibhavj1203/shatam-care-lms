[
 {
  "doctype": "Custom Field",
  "dt": "Course Lesson",
  "fieldname": "review_status",
  "fieldtype": "Select",
  "label": "Review Status",
  "options": "Draft\nSubmitted for Review\nApproved\nRejected",
  "default": "Draft",
  "insert_after": "is_scorm_package",
  "module": "Shatam Care",
  "in_standard_filter": 1,
  "in_list_view": 1,
  "name": "Course Lesson-review_status",
  "reqd": 0
 },
 {
  "doctype": "Custom Field",
  "dt": "Course Lesson",
  "fieldname": "reviewed_by",
  "fieldtype": "Link",
  "label": "Reviewed By",
  "options": "User",
  "insert_after": "review_status",
  "module": "Shatam Care",
  "read_only": 1,
  "name": "Course Lesson-reviewed_by"
 },
 {
  "doctype": "Custom Field",
  "dt": "Course Lesson",
  "fieldname": "review_notes",
  "fieldtype": "Small Text",
  "label": "Review Notes",
  "insert_after": "reviewed_by",
  "module": "Shatam Care",
  "name": "Course Lesson-review_notes"
 },
 {
  "doctype": "Custom Field",
  "dt": "Course Lesson",
  "fieldname": "submitted_on",
  "fieldtype": "Datetime",
  "label": "Submitted On",
  "insert_after": "review_notes",
  "module": "Shatam Care",
  "read_only": 1,
  "name": "Course Lesson-submitted_on"
 },
 {
  "doctype": "Custom Field",
  "dt": "Course Lesson",
  "fieldname": "reviewed_on",
  "fieldtype": "Datetime",
  "label": "Reviewed On",
  "insert_after": "submitted_on",
  "module": "Shatam Care",
  "read_only": 1,
  "name": "Course Lesson-reviewed_on"
 },
 {
  "doctype": "Custom Field",
  "dt": "LMS Quiz",
  "fieldname": "is_final_assessment",
  "fieldtype": "Check",
  "label": "Is Final Assessment",
  "default": "0",
  "insert_after": "course",
  "module": "Shatam Care",
  "description": "Marks the one quiz per course that gates certificate eligibility.",
  "name": "LMS Quiz-is_final_assessment"
 },
 {
  "doctype": "Custom Field",
  "dt": "LMS Enrollment",
  "fieldname": "preferred_language",
  "fieldtype": "Link",
  "label": "Preferred Language",
  "options": "Language",
  "insert_after": "member_username",
  "module": "Shatam Care",
  "name": "LMS Enrollment-preferred_language"
 },
 {
  "doctype": "Custom Field",
  "dt": "LMS Enrollment",
  "fieldname": "student_group",
  "fieldtype": "Link",
  "label": "Student Group",
  "options": "LMS Student Group",
  "insert_after": "preferred_language",
  "module": "Shatam Care",
  "in_standard_filter": 1,
  "name": "LMS Enrollment-student_group"
 },
 {
  "doctype": "Custom Field",
  "dt": "LMS Certificate",
  "fieldname": "certificate_uid",
  "fieldtype": "Data",
  "label": "Certificate UID",
  "unique": 1,
  "read_only": 1,
  "insert_after": "template",
  "module": "Shatam Care",
  "in_standard_filter": 1,
  "name": "LMS Certificate-certificate_uid"
 },
 {
  "doctype": "Custom Field",
  "dt": "LMS Certificate",
  "fieldname": "verification_url",
  "fieldtype": "Data",
  "label": "Verification URL",
  "read_only": 1,
  "insert_after": "certificate_uid",
  "module": "Shatam Care",
  "name": "LMS Certificate-verification_url"
 },
 {
  "doctype": "Custom Field",
  "dt": "LMS Certificate",
  "fieldname": "qr_code",
  "fieldtype": "Attach Image",
  "label": "QR Code",
  "read_only": 1,
  "insert_after": "verification_url",
  "module": "Shatam Care",
  "name": "LMS Certificate-qr_code"
 },
 {
  "doctype": "Custom Field",
  "dt": "User",
  "fieldname": "shatam_capabilities",
  "fieldtype": "Small Text",
  "label": "Shatam Care Capabilities",
  "description": "JSON list of granted capabilities. Admins hold all of them implicitly; this only applies to evaluators.",
  "insert_after": "role_profile_name",
  "module": "Shatam Care",
  "read_only": 1,
  "name": "User-shatam_capabilities"
 },
 {
  "doctype": "Custom Field",
  "dt": "LMS Course",
  "fieldname": "shatam_evaluators",
  "fieldtype": "Table",
  "label": "Certificate Evaluators",
  "options": "LMS Course Evaluator",
  "description": "Everyone who may sign off certificates for this course. Stock LMS Course.evaluator holds only one; the first entry here is mirrored into it so the eligibility record's fetch_from keeps working.",
  "insert_after": "evaluator",
  "module": "Shatam Care",
  "name": "LMS Course-shatam_evaluators"
 }
]
